<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>balancio_nmpc</name>
  <version>0.1.0</version>
  <description>Balancio NMPC and IMU estimator in C++ (CasADi model, acados solver), portable to the ESP32</description>
  <maintainer email="alvgaona@gmail.com">Alvaro</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>yaml-cpp</depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>balancio_description</exec_depend>

  <test_depend>gtest</test_depend>
  <test_depend>balancio_control</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
