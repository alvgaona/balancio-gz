Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 40
      Reference Frame: odom
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/Path
      Name: Reference path
      Enabled: true
      Color: 255; 85; 0
      Topic:
        Value: /balancio/reference_path
    - Class: rviz_default_plugins/Path
      Name: Traveled path
      Enabled: true
      Color: 25; 100; 255
      Topic:
        Value: /balancio/path
    - Class: rviz_default_plugins/Path
      Name: NMPC prediction
      Enabled: true
      Color: 0; 200; 0
      Line Width: 0.01
      Line Style: Billboards
      Topic:
        Value: /balancio/mpc/predicted_path
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Pitch: 0.8
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
